# Public site domain used for canonical URLs, hreflang, sitemap, and OG metadata.
NEXT_PUBLIC_SITE_DOMAIN=https://example.com

# Booking URLs. Leave empty to show "booking page coming soon" and route to
# the contact page instead. NEXT_PUBLIC_BOOKING_URL is a fallback used only
# if a property-specific URL below is not set.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_NAGAYA_BOOKING_URL=
NEXT_PUBLIC_SHIRAKABE_BOOKING_URL=
NEXT_PUBLIC_HIDAMARI_BOOKING_URL=

# Instagram is a confirmed inquiry channel alongside email; the link only
# appears on the contact page once this is set.
NEXT_PUBLIC_INSTAGRAM_URL=
