# Public site domain used for canonical URLs, hreflang, sitemap, and OG metadata.
NEXT_PUBLIC_SITE_DOMAIN=https://example.com

# Booking URLs. Leave empty to show "booking page coming soon" and route to
# the contact page instead. NEXT_PUBLIC_BOOKING_URL is a fallback used only
# if a property-specific URL below is not set.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_NAGAYA_BOOKING_URL=
NEXT_PUBLIC_SHIRAKABE_BOOKING_URL=
NEXT_PUBLIC_HIDAMARI_BOOKING_URL=

# Instagram is a confirmed inquiry channel alongside email; the link only
# appears on the contact page once this is set.
NEXT_PUBLIC_INSTAGRAM_URL=

# Beds24 API V2 (server-side only — do NOT prefix with NEXT_PUBLIC_, or it
# would be bundled into client-side JS and exposed to every site visitor).
# See "Beds24 API V2 setup" in README.md for how to obtain these.
#
# Long-life refresh token, obtained once via `npm run beds24:setup -- <inviteCode>`.
# Treat it like a password: never commit it, never log it, never put it in
# NEXT_PUBLIC_ or client-side code.
BEDS24_REFRESH_TOKEN=
# Override only if Beds24 documents a different API V2 base URL for your account.
BEDS24_API_BASE_URL=https://api.beds24.com/v2

# Authorizes calls to /api/beds24/sync (see "Beds24 booking sync" in
# README.md). A random string, at least 16 characters. Set this in Vercel's
# project environment variables and Vercel Cron Jobs will send it
# automatically as `Authorization: Bearer <value>` — no extra config needed.
# Generate one with: openssl rand -hex 32
CRON_SECRET=
